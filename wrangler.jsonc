{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "h3x-web",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/", "/reports/*"]
  },
  "durable_objects": {"bindings":[{"name":"INVESTIGATION_REPORTS","class_name":"InvestigationReport"},{"name":"H3X_ACCOUNTS","class_name":"H3xAccount"}]},
  "migrations": [{"tag":"v1-investigation-reports","new_sqlite_classes":["InvestigationReport"]},{"tag":"v2-accounts","new_sqlite_classes":["H3xAccount"]}],
  "observability": { "enabled": false }
}
